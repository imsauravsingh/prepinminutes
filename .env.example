# Clerk auth (https://dashboard.clerk.com/~/api-keys)
#
# NEXT_PUBLIC_* vars are inlined into the static bundle at `next build` time —
# this app uses `output: "export"` (no server, no SSR), so there is no way to
# supply them later at request time.
#
# On Cloudflare: set these under the Worker's BUILD environment variables
# (Settings -> Builds), NOT under "Variables and Secrets" on the Worker
# itself — that page only sets runtime bindings for worker/index.ts and has
# no effect on `next build`.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon PostgreSQL Database (Layer 6 Persistence)
# Pooled connection string (for Prisma Client & runtime serverless API queries)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[database]?sslmode=require"

# Direct connection string (without -pooler, required for Prisma migrations & schema changes)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[database]?sslmode=require"

# Upstash Redis (Layer 2 & 6: Rate Limiting, Idempotency & Caching)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# Cloudflare R2 Object Storage (Layer 6: Whiteboards, Audio, PDFs)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="prepinminutes-assets"

# AI / LLM Providers (Layer 4 & 5: Embeddings & Evaluators)
GEMINI_API_KEY="your_gemini_api_key"
GOOGLE_AI_PROJECT_ID="projects/your_project_id"
GOOGLE_AI_PROJECT_NUMBER="your_project_number"
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx"

# Real-Time Voice Streaming (Layer 3: Mock Interview STT & TTS)
DEEPGRAM_PROJECT_ID="your_deepgram_project_id"
DEEPGRAM_API_KEY="your_deepgram_api_key"
CARTESIA_API_KEY="sk_car_xxxxxxxxxxxxxxxxxxxx"
