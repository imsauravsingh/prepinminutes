# Clerk auth (https://dashboard.clerk.com/~/api-keys)
#
# NEXT_PUBLIC_* vars are inlined into the static bundle at `next build` time —
# this app uses `output: "export"` (no server, no SSR), so there is no way to
# supply them later at request time.
#
# On Cloudflare: set these under the Worker's BUILD environment variables
# (Settings -> Builds), NOT under "Variables and Secrets" on the Worker
# itself — that page only sets runtime bindings for worker/index.ts and has
# no effect on `next build`.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
